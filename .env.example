# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente — copie para .env.local e preencha.
# Nunca faça commit do .env.local.
# ─────────────────────────────────────────────────────────────

# URL do projeto Supabase (Project Settings → API → Project URL).
# Pública: vai para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon" (pública). Segura para o navegador porque TODAS as
# tabelas têm RLS habilitado. (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — SECRETA, ignora RLS. Usada somente no servidor:
# apagar conta (LGPD), painel /admin e seed. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails com acesso ao painel /admin, separados por vírgula.
ADMIN_EMAILS=admin@exemplo.com,outra.admin@exemplo.com
